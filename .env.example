# Clé d'accès Web3Forms (https://web3forms.com). Si elle est absente, le formulaire de contact
# ouvre la messagerie de l'internaute avec un message prérempli (mailto).
VITE_WEB3FORMS_KEY=

# Adresse de réception : destinataire du mailto, affichée dans la page de contact.
VITE_CONTACT_EMAIL=contact@institut-milon.fr
